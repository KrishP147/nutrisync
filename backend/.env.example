# Google Gemini API Key for AI-powered food recognition and recommendations
GOOGLE_API_KEY=your_google_gemini_api_key_here

# USDA FoodData Central API Key for food database
USDA_API_KEY=your_usda_api_key_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Note: SUPABASE_SERVICE_ROLE_KEY is required for admin operations like deleting users
# Find it in: Supabase Dashboard > Project Settings > API > service_role (secret)
# WARNING: Keep this key secret - it has full admin access to your database
